{
  "id": "telecom-default",
  "name": "Telecom Default",
  "version": "1.0.0",
  "description": "Telecom native theme inspired by Telegram's dark theme",
  "author": "Telecom",
  
  "colors": {
    "background": {
      "primary": "#E6D9F5",
      "secondary": "#D4C4ED",
      "tertiary": "#C9B5E8"
    },
    "text": {
      "primary": "#0a0a0a",
      "secondary": "#404040",
      "accent": "#3390EC"
    },
    "ui": {
      "topbar": "#D4C4ED",
      "sidebar": "#E6D9F5",
      "chatArea": "#c8e6c9",
      "chatAreaPattern": "dots",
      "inputArea": "#D4C4ED",
      "border": "#808080",
      "hover": "#FFB366",
      "active": "#FFB366",
      "avatar": "#3390EC"
    },
    "status": {
      "online": "#4CAF50",
      "offline": "#707070",
      "away": "#FF9800",
      "busy": "#F44336"
    },
    "message": {
      "sent": {
        "background": "#FFB366",
        "text": "#2a2a2a"
      },
      "received": {
        "background": "#FFB366",
        "text": "#2a2a2a"
      }
    },
    "buttons": {
      "primary": {
        "background": "#3390EC",
        "text": "#ffffff",
        "hover": "#2A7FD9"
      },
      "secondary": {
        "background": "#8e8e8e",
        "text": "#0a0a0a",
        "hover": "#808080"
      },
      "danger": {
        "background": "#F44336",
        "text": "#ffffff",
        "hover": "#D32F2F"
      }
    }
  },
  
  "typography": {
    "fontFamily": "'Segoe UI', 'Segoe UI Historic', 'Segoe UI Emoji', 'Segoe UI Symbol', -apple-system, BlinkMacSystemFont, 'Roboto', 'Helvetica Neue', Arial, sans-serif",
    "fontSizes": {
      "xs": "0.75rem",
      "sm": "0.85rem",
      "base": "0.95rem",
      "md": "1rem",
      "lg": "1.1rem",
      "xl": "1.25rem",
      "2xl": "1.5rem"
    },
    "fontWeights": {
      "normal": "400",
      "medium": "500",
      "semibold": "600",
      "bold": "700"
    },
    "lineHeights": {
      "tight": "1.2",
      "normal": "1.4",
      "relaxed": "1.6"
    }
  },
  
  "spacing": {
    "xs": "4px",
    "sm": "8px",
    "md": "12px",
    "lg": "16px",
    "xl": "24px",
    "2xl": "32px",
    "3xl": "40px"
  },
  
  "borderRadius": {
    "sm": "4px",
    "md": "6px",
    "lg": "8px",
    "xl": "12px",
    "full": "50%"
  },
  
  "shadows": {
    "sm": "0 1px 2px rgba(0, 0, 0, 0.1)",
    "md": "0 4px 8px rgba(0, 0, 0, 0.15)",
    "lg": "0 10px 20px rgba(0, 0, 0, 0.2)",
    "xl": "0 20px 40px rgba(0, 0, 0, 0.25)"
  },
  
  "transitions": {
    "fast": "0.1s ease",
    "normal": "0.2s ease",
    "slow": "0.3s ease"
  },
  
  "components": {
    "topbar": {
      "height": "54px",
      "padding": "0 16px",
      "background": "#8e8e8e",
      "borderBottom": "1px solid #808080"
    },
    "sidebar": {
      "width": "320px",
      "background": "#9e9e9e",
      "borderRight": "1px solid #808080"
    },
    "chatHeader": {
      "height": "auto",
      "padding": "12px 16px",
      "background": "#8e8e8e",
      "borderBottom": "1px solid #808080"
    },
    "messageBubble": {
      "sent": {
        "maxWidth": "70%",
        "padding": "8px 12px",
        "borderRadius": "12px 12px 4px 12px",
        "background": "#FF7F00",
        "color": "#ffffff",
        "marginLeft": "auto"
      },
      "received": {
        "maxWidth": "70%",
        "padding": "8px 12px",
        "borderRadius": "12px 12px 12px 4px",
        "background": "#ffffff",
        "color": "#212121",
        "marginRight": "auto"
      }
    },
    "inputArea": {
      "padding": "12px 16px",
      "background": "#8e8e8e",
      "borderTop": "1px solid #808080"
    },
    "avatar": {
      "size": {
        "sm": "32px",
        "md": "40px",
        "lg": "120px"
      },
      "borderRadius": "50%"
    },
    "dialog": {
      "header": {
        "background": "#c8e6c9",
        "borderBottom": "1px solid #808080"
      },
      "backdrop": {
        "background": "rgba(0, 0, 0, 0.75)"
      }
    }
  }
}
